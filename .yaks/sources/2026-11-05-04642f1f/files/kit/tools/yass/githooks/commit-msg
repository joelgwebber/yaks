#!/bin/sh
# YASS commit-msg hook: with plans kept apart from the code, checks the commit names its change in a
# `yass:` trailer. A heads-up by default; with `trailers: require` in yass.yaml, it refuses the commit.
# It does nothing when plans are in the repo.
if ! command -v yass >/dev/null 2>&1; then
  exit 0
fi
# A yass from before trailers doesn't know this hook: skip it rather than block the commit.
if ! yass hook --help 2>&1 | grep -q -- '--commit-msg'; then
  exit 0
fi
exec yass hook --commit-msg "$@"
